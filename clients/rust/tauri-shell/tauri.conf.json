{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EclipticRD",
  "version": "0.1.0",
  "identifier": "com.eclipticrd.shell",
  "build": {
    "frontendDist": "./dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EclipticRD",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
